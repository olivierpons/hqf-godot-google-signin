[configuration]
entry_symbol = "hqf_google_signin_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
linux.x86_64 = "res://addons/hqf_google_signin/bin/libhqf_google_signin.linux.release.x86_64.so"
android.arm64 = "res://addons/hqf_google_signin/bin/libhqf_google_signin.android.release.arm64.so"
android.arm32 = "res://addons/hqf_google_signin/bin/libhqf_google_signin.android.release.arm32.so"
android.x86_64 = "res://addons/hqf_google_signin/bin/libhqf_google_signin.android.release.x86_64.so"

[icons]
HqfGoogleSignIn = "res://addons/hqf_google_signin/icon.svg"
